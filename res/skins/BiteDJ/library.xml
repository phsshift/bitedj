<Template>
  <WidgetGroup>
    <SizePolicy>me,e</SizePolicy>
    <Layout>vertical</Layout>
    <Children>
      <!-- Touch targets use the existing loader and its playing-deck guards. -->
      <WidgetGroup>
        <ObjectName>TouchTrackLoadRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,66f</Size>
        <Children>
          <PushButton>
            <ObjectName>TouchLoadDeck1</ObjectName>
            <Size>210me,66f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>Load Deck 1</Text></State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[Channel1],LoadSelectedTrack</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>TouchLoadDeck2</ObjectName>
            <Size>210me,66f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>Load Deck 2</Text></State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[Channel2],LoadSelectedTrack</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
        </Children>
        <Connection>
          <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
          <BindProperty>visible</BindProperty>
          <Transform><Not/></Transform>
        </Connection>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>LibraryWrapper</ObjectName>
        <Layout>vertical</Layout>
        <Size>0me,0me</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>SidebarContainer</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,64max</Size>
            <Connection>
              <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform><Not/></Transform>
            </Connection>
            <Children>
              <LibraryBreadcrumb>
                <ObjectName>LibraryBreadcrumb</ObjectName>
                <SizePolicy>me,me</SizePolicy>
                <Alignment>left</Alignment>
                <Elide>left</Elide>
              </LibraryBreadcrumb>
              <!-- Searches the open playlist or device; a drive's All Tracks
                   searches the whole drive. Tapping it raises the on-screen
                   keyboard; Enter or Escape lowers it again. -->
              <SearchBox>
                <ObjectName>SearchBox</ObjectName>
                <Size>120me,64p</Size>
                <BgColor>#2d1335</BgColor>
                <FgColor>#e5e6ea</FgColor>
              </SearchBox>
              <PushButton>
                <ObjectName>RelatedButton</ObjectName>
                <Size>84p,40p</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>Related</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>Related</Text>
                </State>
                <Connection>
                  <ConfigKey>[Skin],show_related</ConfigKey>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>SidebarButton</ObjectName>
                <Size>100p,40p</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>Back</Text>
                </State>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                  <BindProperty>visible</BindProperty>
                  <Transform><Not/></Transform>
                </Connection>
                <Elide>right</Elide>
              </PushButton>
            </Children>
          </WidgetGroup>
          <!-- Related searches for the selected track, under the search box
               they fill (WRelatedSearch). Hidden with the rest of the library
               chrome while the sidebar is up. -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <!-- max: collapses to nothing while the row inside is hidden. -->
            <SizePolicy>me,max</SizePolicy>
            <Connection>
              <ConfigKey>[Skin],show_related</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
            <Children>
              <WidgetGroup>
                <ObjectName>RelatedSearchRow</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,48f</Size>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                  <BindProperty>visible</BindProperty>
                  <Transform><Not/></Transform>
                </Connection>
                <Children>
                  <RelatedSearch>
                    <ObjectName>RelatedSearch</ObjectName>
                    <Size>0me,0me</Size>
                  </RelatedSearch>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <SizePolicy>me,me</SizePolicy>
            <Layout>horizontal</Layout>
            <Size>0me,0me</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>LibraryWrapper</ObjectName>
                <Layout>horizontal</Layout>
                <Children>
                  <Library>
                    <ObjectName>Library</ObjectName>
                    <Size>0me,0me</Size>
                    <BgColor>#000</BgColor>
                    <FgColor>#75001a</FgColor>
                    <TrackTableBackgroundColorOpacity>0.4</TrackTableBackgroundColorOpacity>
                  </Library>
                </Children>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                  <BindProperty>visible</BindProperty>
                  <Transform><Not/></Transform>
                </Connection>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SidebarWrapper</ObjectName>
                <Layout>horizontal</Layout>
                <Children>
                  <LibrarySidebar>
                    <ObjectName>LibrarySidebar</ObjectName>
                    <Size>0me,0me</Size>
                    <HiddenFeatures>Tracks,Auto DJ,Playlists,Crates</HiddenFeatures>
                  </LibrarySidebar>
                </Children>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>Decks</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,50max</Size>
        <Children>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">1</SetVariable>
          </Template>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">2</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
